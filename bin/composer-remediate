#!/usr/bin/env php
<?php

/*
 * Standalone entry point for Composer Remediate.
 *
 * `composer remediate` runs inside Composer's own command dispatch, which has already activated
 * every plugin the analysed project allows before this command starts. This binary runs the same
 * commands with `--no-plugins --no-scripts` forced from the first instruction, so nothing from the
 * analysed project executes during planning.
 *
 * To keep that promise it never includes a project's vendor/autoload.php: Composer's autoloader runs
 * every `autoload.files` entry of the root package and its dependencies, which is project code.
 * Instead it loads Composer's classes from the Composer phar it finds (REMEDIATE_COMPOSER_BINARY, or
 * `composer` on PATH) and registers the plugin's own classes with a plain PSR-4 mapping.
 */

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, 'composer-remediate must run from the command line.' . PHP_EOL);
    exit(3);
}

/**
 * Loads Composer's classes from a phar. Returns false when the candidate is not a phar carrying
 * Composer's bootstrap. Source checkouts are accepted only when named explicitly through
 * REMEDIATE_COMPOSER_BINARY, because their bootstrap includes that checkout's vendor/autoload.php.
 */
$bootComposer = static function (string $candidate, bool $allowSourceCheckout): bool {
    $real = realpath($candidate);
    if ($real === false || !is_file($real)) {
        return false;
    }
    try {
        Phar::loadPhar($real, 'composer.phar');
        if (is_file('phar://composer.phar/src/bootstrap.php')) {
            require 'phar://composer.phar/src/bootstrap.php';

            return class_exists(Composer\Console\Application::class);
        }
    } catch (Throwable) {
        // not a phar
    }
    if ($allowSourceCheckout) {
        $bootstrap = dirname($real) . '/../src/bootstrap.php';
        if (is_file($bootstrap) && is_file(dirname($real) . '/../src/Composer/Console/Application.php')) {
            require $bootstrap;

            return class_exists(Composer\Console\Application::class);
        }
    }

    return false;
};

$composerBinary = null;
$explicit = getenv('REMEDIATE_COMPOSER_BINARY');
if (is_string($explicit) && $explicit !== '') {
    if (!$bootComposer($explicit, true)) {
        fwrite(STDERR, sprintf('composer-remediate: REMEDIATE_COMPOSER_BINARY=%s is not a Composer phar or source checkout.%s', $explicit, PHP_EOL));
        exit(3);
    }
    $composerBinary = realpath($explicit) ?: $explicit;
} else {
    foreach (explode(PATH_SEPARATOR, (string) getenv('PATH')) as $dir) {
        if ($dir === '') {
            continue;
        }
        foreach (['composer', 'composer.phar'] as $name) {
            $path = rtrim($dir, '/\\') . DIRECTORY_SEPARATOR . $name;
            if (is_file($path) && $bootComposer($path, false)) {
                $composerBinary = realpath($path) ?: $path;
                break 2;
            }
        }
    }
}

if ($composerBinary === null) {
    // Development checkout of this repository: composer/composer is a dev dependency. This autoloader
    // belongs to the plugin itself, never to an analysed project (a dependency install has no vendor/).
    $own = __DIR__ . '/../vendor/autoload.php';
    if (is_file($own) && is_dir(__DIR__ . '/../vendor/composer/composer')) {
        require $own;
    }
}
if (!class_exists(Composer\Console\Application::class)) {
    fwrite(STDERR, 'composer-remediate: no Composer installation found. Put the composer phar on PATH or set REMEDIATE_COMPOSER_BINARY.' . PHP_EOL);
    exit(3);
}
if ($composerBinary !== null) {
    putenv('REMEDIATE_COMPOSER_BINARY=' . $composerBinary);
}

// The plugin's own classes, plus symfony/yaml (used by remediate:db-build for FriendsOfPHP), through
// a PSR-4 mapping only: no autoload.files of any project run.
$loader = new Composer\Autoload\ClassLoader();
$loader->addPsr4('Remediate\\', __DIR__ . '/../src');
foreach ([__DIR__ . '/../../../symfony/yaml', __DIR__ . '/../vendor/symfony/yaml'] as $yaml) {
    if (is_dir($yaml) && !class_exists(Symfony\Component\Yaml\Yaml::class, false)) {
        $loader->addPsr4('Symfony\\Component\\Yaml\\', $yaml);
        break;
    }
}
$loader->register(true);

use Composer\Console\Application;
use Composer\Util\Platform;
use Remediate\Command\DbBuildCommand;
use Remediate\Command\DbStatusCommand;
use Remediate\Command\RemediateCommand;
use Symfony\Component\Console\Input\ArgvInput;

error_reporting(-1);
setlocale(LC_ALL, 'C');

$argv = is_array($_SERVER['argv'] ?? null) ? array_values($_SERVER['argv']) : ['composer-remediate'];
$args = array_slice($argv, 1);
// --offline must take effect before Composer builds any HttpDownloader.
if (in_array('--offline', $args, true)) {
    Platform::putEnv('COMPOSER_DISABLE_NETWORK', '1');
}
$commandNames = ['remediate', 'remediate:db-build', 'remediate-db-build', 'remediate:db-status', 'remediate-db-status', 'list', 'help'];
$first = $args[0] ?? null;
if ($first === null || str_starts_with($first, '-') || !in_array($first, $commandNames, true)) {
    array_unshift($args, 'remediate');
}
$input = new ArgvInput([$argv[0], '--no-plugins', '--no-scripts', ...$args]);

$application = new Application();
$application->setName('Composer Remediate');
$application->add(new RemediateCommand());
$application->add(new DbBuildCommand());
$application->add(new DbStatusCommand());
$application->setAutoExit(false);

exit($application->run($input));

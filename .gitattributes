# Keep GitHub's language statistics about the tool, not about its test data.
# Stored example reports are generated by bin/run-fixture.php --write-reports.
tests/Fixture/**/reports/** linguist-generated=true
# Frozen fixture inputs: real projects' composer.json/composer.lock, advisory snapshots, static repositories.
tests/Fixture/**/composer.json linguist-vendored=true
tests/Fixture/**/composer.lock linguist-vendored=true
tests/Fixture/**/advisories.json linguist-vendored=true
tests/Fixture/**/repo/** linguist-vendored=true
tests/Fixture/**/expected.json linguist-vendored=true
# Generated documentation.
docs/cli-reference.md linguist-generated=true
# Compressed fixture repositories are binary.
*.gz binary

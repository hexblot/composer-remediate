                    "informationUri": "https://hexblot.github.io/composer-remediate/",
                    "rules": [
                        {
                            "id": "PKSA-n3s6-289w-qtqb",
                            "name": "CVE202351651",
                            "shortDescription": {
                                "text": "Potential URI resolution path traversal in the AWS SDK for PHP"
                            },
                            "fullDescription": {
                                "text": "Potential URI resolution path traversal in the AWS SDK for PHP. Affected versions of aws/aws-sdk-php: >=3.0.0,<3.288.1."
                            },
                            "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2023-51651",
                            "help": {
                                "text": "Advisory PKSA-n3s6-289w-qtqb (CVE-2023-51651) affects aws/aws-sdk-php >=3.0.0,<3.288.1. Run composer remediate for the smallest verified upgrade."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "properties": {
                                "security-severity": "5.0",
                                "tags": [
                                    "security",
                                    "vulnerability",
                                    "medium"
                                ]
                            }

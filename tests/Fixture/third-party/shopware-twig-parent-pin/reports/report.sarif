                    "properties": {
                        "composer_version": "(fixture)",
                        "advisory_source": "advisory snapshot advisories.json",
                        "combined_command": "composer update shopware/storefront:6.4.15.2 shopware/recovery shopware/elasticsearch shopware/administration -W -m"
                    }

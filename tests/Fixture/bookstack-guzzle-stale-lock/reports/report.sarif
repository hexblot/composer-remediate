{
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "version": "2.1.0",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "composer-remediate",
                    "version": "dev-main",
                    "informationUri": "https://hexblot.github.io/composer-remediate/",
                    "rules": [
                        {
                            "id": "PKSA-872h-8556-2chm",
                            "name": "CVE20220085",
                            "shortDescription": {
                                "text": "Server-Side Request Forgery in dompdf/dompdf"
                            },
                            "fullDescription": {
                                "text": "Server-Side Request Forgery in dompdf/dompdf. Affected versions of dompdf/dompdf: <2.0.0."
                            },
                            "helpUri": "https://github.com/advisories/GHSA-pf6p-25r2-fx45",
                            "help": {
                                "text": "Advisory PKSA-872h-8556-2chm (CVE-2022-0085) affects dompdf/dompdf <2.0.0. Run composer remediate for the smallest verified upgrade."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "properties": {
                                "security-severity": "5.0",
                                "tags": [
                                    "security",
                                    "vulnerability",
                                    "medium"
                                ]
                            }
                        },
                        {
                            "id": "PKSA-2z36-j4q9-rsfy",
                            "name": "CVE202231043",
                            "shortDescription": {
                                "text": "Fix failure to strip Authorization header on HTTP downgrade"
                            },
                            "fullDescription": {
                                "text": "Fix failure to strip Authorization header on HTTP downgrade. Affected versions of guzzlehttp/guzzle: >=7,<7.4.4|>=4,<6.5.7."
                            },
                            "helpUri": "https://github.com/guzzle/guzzle/security/advisories/GHSA-w248-ffj2-4v5q",
                            "help": {
                                "text": "Advisory PKSA-2z36-j4q9-rsfy (CVE-2022-31043) affects guzzlehttp/guzzle >=7,<7.4.4|>=4,<6.5.7. Run composer remediate for the smallest verified upgrade."
                            },
                            "defaultConfiguration": {
                                "level": "error"
                            },
                            "properties": {
                                "security-severity": "7.5",
                                "tags": [
                                    "security",
                                    "vulnerability",
                                    "high"
                                ]
                            }
                        },
